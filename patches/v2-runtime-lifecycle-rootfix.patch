+        for _ in 0..UNLOAD_READINESS_RETRY_COUNT {
+            let Ok(thread) = state.get_thread(thread_id).await else {
+                return;
+            };
+            if is_unloadable(thread.as_ref()).await {
+                candidate_thread = Some(thread);
+                break;
+            }
+            sleep(UNLOAD_READINESS_RETRY_DELAY).await;
+        }
+        let Some(candidate_thread) = candidate_thread else {
+            warn!("completed agent {thread_id} did not become idle for runtime unload");
+            return;
