+/// Return the last persisted lifecycle status for a child without constructing its runtime.
+///
+/// Legacy V1 stored `Open` spawn edges even after a child had emitted a terminal event.  The
+/// edge is topology, not a reliable lifecycle source, so repair it from the child's durable
+/// rollout before the legacy resume walk has a chance to start MCP, plugins, or other runtime.
+async fn persisted_terminal_agent_status(
+    state: &ThreadManagerState,
+    thread_id: ThreadId,
+) -> CodexResult<Option<AgentStatus>> {
+    let stored_thread = state
+        .read_stored_thread(ReadThreadParams {
+            thread_id,
+            include_archived: true,
+            include_history: false,
+        })
+        .await?;
+    let Some(history) =
+        load_agent_model_context(state, thread_id, stored_thread.history_mode).await?
+    else {
+        return Ok(None);
+    };
+    let mut shutdown_fallback = None;
+    for item in history.iter().rev() {
+        let RolloutItem::EventMsg(event) = item else {
+            continue;
+        };
+        let Some(status) = agent_status_from_event(event) else {
+            continue;
+        };
+        if matches!(status, AgentStatus::Shutdown) {
+            shutdown_fallback.get_or_insert(status);
+            continue;
+        }
+        if is_final(&status) {
+            // Runtime shutdown is recorded after the task result. Prefer the durable task
+            // outcome so a restored completed child is reported as Done, not merely unloaded.
+            return Ok(Some(status));
+        }
+    }
+    Ok(shutdown_fallback)
+}
