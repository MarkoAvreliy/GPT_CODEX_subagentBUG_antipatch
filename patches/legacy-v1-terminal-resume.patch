+#[tokio::test]
+async fn completed_legacy_child_is_repaired_without_resuming_runtime() {
+    let harness = AgentControlHarness::new().await;
+    let (parent_thread_id, parent_thread) = harness.start_thread().await;
+    let child_thread_id = harness
+        .control
+        .spawn_agent(
+            harness.config.clone(),
+            text_input("hello child"),
+            Some(SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id,
+                depth: 1,
+                agent_path: None,
+                agent_nickname: None,
+                agent_role: Some("worker".to_string()),
+            })),
+        )
+        .await
+        .expect("child spawn should succeed");
+    let child_thread = harness
+        .manager
+        .get_thread(child_thread_id)
+        .await
+        .expect("child thread should exist");
+    persist_thread_for_tree_resume(&parent_thread, "parent persisted").await;
+    wait_for_live_thread_spawn_children(&harness.control, parent_thread_id, &[child_thread_id])
+        .await;
+    let child_turn = child_thread.session.new_default_turn().await;
+    child_thread
+        .session
+        .send_event(
+            child_turn.as_ref(),
+            EventMsg::TurnComplete(TurnCompleteEvent {
+                turn_id: child_turn.sub_id.clone(),
+                started_at: None,
+                last_agent_message: Some("done".to_string()),
+                error: None,
+                completed_at: None,
+                duration_ms: None,
+                time_to_first_token_ms: None,
+            }),
+        )
+        .await;
+    child_thread.session.ensure_rollout_materialized().await;
+    child_thread
+        .session
+        .flush_rollout()
+        .await
+        .expect("completed child rollout should flush");
+
+    let state = harness
+        .control
+        .upgrade()
+        .expect("thread manager should be live");
+    let graph = state.agent_graph_store().expect("agent graph should exist");
+    timeout(Duration::from_secs(5), async {
+        loop {
+            let closed = graph
+                .list_thread_spawn_children(parent_thread_id, Some(ThreadSpawnEdgeStatus::Closed))
+                .await
+                .expect("closed child list should load");
+            if closed == vec![child_thread_id] {
+                break;
+            }
+            sleep(Duration::from_millis(25)).await;
+        }
+    })
+    .await
+    .expect("normal completion should close its child edge");
+
+    let _ = harness
+        .control
+        .shutdown_live_agent(child_thread_id)
+        .await
+        .expect("completed child should shut down");
+    let _ = harness
+        .control
+        .shutdown_live_agent(parent_thread_id)
+        .await
+        .expect("parent should shut down");
+    assert_thread_not_loaded(&harness.manager, child_thread_id).await;
+
+    // Simulate the historical defect after the old runtime is gone: completion is durable, but
+    // the persisted spawn edge incorrectly remains open across the next application launch.
+    graph
+        .set_thread_spawn_edge_status(child_thread_id, ThreadSpawnEdgeStatus::Open)
+        .await
+        .expect("stale edge should be writable");
+
+    harness
+        .control
+        .resume_agent_from_rollout(
+            harness.config.clone(),
+            parent_thread_id,
+            SessionSource::Exec,
+        )
+        .await
+        .expect("parent resume should succeed");
+
+    assert_thread_not_loaded(&harness.manager, child_thread_id).await;
+    assert_eq!(
+        graph
+            .list_thread_spawn_children(parent_thread_id, Some(ThreadSpawnEdgeStatus::Open))
+            .await
+            .expect("open child list should load"),
+        Vec::<ThreadId>::new()
+    );
+    assert_eq!(
+        graph
+            .list_thread_spawn_children(parent_thread_id, Some(ThreadSpawnEdgeStatus::Closed))
+            .await
+            .expect("closed child list should load"),
+        vec![child_thread_id]
+    );
+
+    let _ = harness
+        .control
+        .shutdown_live_agent(parent_thread_id)
+        .await
+        .expect("resumed parent should shut down");
+}
